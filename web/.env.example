# Copy to .env and fill in. Never commit .env.
FINNHUB_API_KEY=
# "sample" (default, stored sample chain) or "cboe" (delayed CBOE feed; read the README terms note first)
OPTIONS_SOURCE=sample
# Long random string used to sign session cookies (required in production)
AUTH_SECRET=
# Local dev uses a file. On Vercel use your Turso database URL + token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
